{
  "name": "omkar-joshi-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --watch-path=src --watch-path=content --watch-path=public --watch-path=scripts scripts/server.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/server.mjs --preview",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "js-yaml": "4.1.1",
    "marked": "16.4.2"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
